{
  "name": "galaxi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit --project tsconfig.web.json && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "spike": "tsx scripts/spike.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:browser": "tsx scripts/browser-qa.ts",
    "test:browser-execution": "tsx scripts/browser-execution.ts",
    "format": "prettier --write src server shared tests scripts docs README.md",
    "test:recovery": "tsx scripts/recovery.ts",
    "test:visual": "tsx scripts/city-visual-qa.ts",
    "test:watch": "tsx --env-file-if-exists=.env scripts/mirror-browser.ts",
    "test:ui": "tsx scripts/ui-qa.ts",
    "test:outpost": "tsx scripts/outpost-qa.ts",
    "test:pairing": "npm run build && tsx scripts/pairing-browser-qa.ts",
    "desktop:prepare": "npm run build && node scripts/build-desktop.mjs",
    "desktop:build": "npm run desktop:prepare && electron-builder --config desktop/builder.cjs --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "vite": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@openai/codex": "0.167.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
